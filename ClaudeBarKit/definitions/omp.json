{
  "profile": {
    "id": "omp",
    "name": "Oh My Pi",
    "links": { "dashboard": "https://omp.sh" },
    "look": {
      "symbol": "terminal.fill",
      "icon": "OmpIcon",
      "color": { "light": [0.16, 0.62, 0.38], "dark": [0.3, 0.85, 0.55] },
      "gradientEnd": { "light": [0.1, 0.48, 0.3], "dark": [0.16, 0.62, 0.42] }
    }
  },
  "cli": "omp",
  "enabledByDefault": true,
  "order": 190,
  "defaultDataSource": "cli",
  "dataSources": [
    {
      "kind": "cli",
      "label": "CLI",
      "summary": "Runs `omp usage --json` for every account Oh My Pi tracks",
      "fetch": { "command": { "cli": "omp", "args": ["usage", "--json"], "timeout": 30 } },
      "cache": { "ttl": 300 },
      "mapping": { "script": { "file": "omp-usage.js" } },
      "errors": { "cli.missing": { "cliNotFound": "omp" } }
    }
  ],
  "usageHistory": {
    "records": {
      "files": "${PI_CODING_AGENT_DIR:-~/.omp/agent}/sessions/**/*.jsonl",
      "format": "jsonLines",
      "shapes": [
        {
          "where": { "path": "$.message.role", "equals": "assistant" },
          "at": "$.timestamp",
          "id": ["$.id", "$.timestamp"],
          "tokens": {
            "input": "$.message.usage.input",
            "output": "$.message.usage.output",
            "cacheWrite": "$.message.usage.cacheWrite",
            "cacheRead": "$.message.usage.cacheRead"
          },
          "cost": "$.message.usage.cost.total"
        },
        {
          "where": { "path": "$.type", "equals": "model_usage" },
          "at": "$.timestamp",
          "id": ["$.id", "$.timestamp"],
          "tokens": {
            "input": "$.usage.input",
            "output": "$.usage.output",
            "cacheWrite": "$.usage.cacheWrite",
            "cacheRead": "$.usage.cacheRead"
          },
          "cost": "$.usage.cost.total"
        }
      ]
    },
    "sessionGap": 1800
  }
}
