{
  "profile": {
    "id": "windsurf",
    "name": "Windsurf",
    "links": { "dashboard": "https://windsurf.com/subscription/usage" },
    "look": {
      "symbol": "wind",
      "icon": "WindsurfIcon",
      "color": { "light": [0.0, 0.55, 0.5], "dark": [0.2, 0.8, 0.72] },
      "gradientEnd": { "light": [0.0, 0.38, 0.36], "dark": [0.1, 0.6, 0.55] }
    }
  },
  "enabledByDefault": false,
  "order": 250,
  "defaultDataSource": "local",
  "dataSources": [
    {
      "kind": "local",
      "label": "Windsurf app",
      "summary": "Reads the plan Devin Desktop (formerly Windsurf) saves on this computer, read-only. It updates while the app runs.",
      "fetch": {
        "sqlite": {
          "path": [
            "{{platform.appData}}/Devin/User/globalStorage/state.vscdb",
            "{{platform.appData}}/Windsurf/User/globalStorage/state.vscdb"
          ],
          "query": "SELECT key, value FROM ItemTable WHERE key LIKE 'windsurf.reactSettings.cachedPlanInfoData%' OR key = 'windsurf.settings.cachedPlanInfo'"
        }
      },
      "mapping": { "script": { "file": "windsurf-plan.js" } }
    }
  ]
}
