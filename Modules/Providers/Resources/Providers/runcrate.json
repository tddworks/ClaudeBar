{
  "profile": {
    "id": "runcrate",
    "name": "Runcrate",
    "links": { "dashboard": "https://runcrate.ai/dashboard" },
    "look": {
      "symbol": "terminal.fill",
      "icon": "RunCrateIcon",
      "color": { "light": [0.16, 0.25, 0.78], "dark": [0.3, 0.42, 0.95] },
      "gradientEnd": { "light": [0.07, 0.12, 0.5], "dark": [0.16, 0.24, 0.72] }
    }
  },
  "enabledByDefault": false,
  "order": 290,
  "settings": [
    { "id": "apiKey", "label": "API key", "kind": "secret", "scope": "account" },
    { "id": "authEnvVar", "label": "Environment variable", "default": "RUNCRATE_API_KEY" }
  ],
  "defaultDataSource": "api",
  "dataSources": [
    {
      "kind": "api",
      "label": "API",
      "summary": "Reads the Runcrate credit balance.",
      "credential": { "firstOf": [ { "environment": "{{setting.authEnvVar}}" }, { "setting": "apiKey" } ] },
      "fetch": {
        "http": {
          "url": "https://api.runcrate.ai/v1/credits",
          "headers": { "Authorization": "Bearer {{token}}", "Accept": "application/json" },
          "timeout": 30
        }
      },
      "mapping": {
        "json": {
          "quotas": [ { "kind": "model", "name": "Credits", "left": { "money": "$.credits.balance", "currency": "USD" } } ],
          "whenEmpty": { "otherwise": "Invalid or missing balance" },
          "notAnObject": "Invalid credits response"
        }
      }
    }
  ]
}
