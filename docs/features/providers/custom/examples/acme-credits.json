{
  "profile": {
    "id": "acme-credits",
    "name": "Acme Credits",
    "links": { "dashboard": "https://acme.example/billing" },
    "look": { "symbol": "creditcard" }
  },
  "settings": [
    { "id": "apiKey", "label": "API key", "kind": "secret", "scope": "account" },
    { "id": "authEnvVar", "label": "Environment variable", "default": "ACME_API_KEY" }
  ],
  "defaultDataSource": "api",
  "dataSources": [
    {
      "kind": "api",
      "label": "API",
      "summary": "Reads the credits left of the monthly limit.",
      "credential": { "firstOf": [ { "environment": "{{setting.authEnvVar}}" }, { "setting": "apiKey" } ] },
      "fetch": {
        "http": {
          "url": "https://api.acme.example/v1/credits",
          "headers": { "Authorization": "Bearer {{token}}", "Accept": "application/json" },
          "timeout": 30
        }
      },
      "mapping": {
        "json": {
          "quotas": [
            {
              "kind": "model",
              "name": "Monthly credits",
              "left": { "money": "$.remaining", "of": "$.limit", "currency": "USD" }
            }
          ],
          "whenEmpty": { "otherwise": "No credits in the answer" }
        }
      }
    }
  ]
}
