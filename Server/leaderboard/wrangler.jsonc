{
  // ClaudeBar Leaderboard API. See docs/features/leaderboard/design.md.
  "name": "claudebar-leaderboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  // Invocation logs would record client IPs and headers: off.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "ratelimits": [
    { "name": "JOIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "RENAME_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  "triggers": { "crons": ["0 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "claudebar-leaderboard",
      // Filled in after `wrangler d1 create claudebar-leaderboard`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
